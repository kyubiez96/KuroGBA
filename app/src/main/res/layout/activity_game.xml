<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- Emulator screen -->
    <com.kyubiez96.kurogba.ScreenView
        android:id="@+id/screenView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar: indicators + menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/batteryIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#66000000"
            android:padding="6dp"
            android:textColor="#8FE388"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ffBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#66000000"
            android:padding="6dp"
            android:textColor="@color/kuro_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/menuButton"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:background="#66000000"
            android:text="•••"
            android:textColor="@color/kuro_text"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Touch controls are added here from code. -->
    <FrameLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
